{
  "lexicon": 1,
  "id": "app.changala.globalview.getTrendingKeywords",
  "description": "Get institution-wide trending keywords across live and recent sessions.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get institution-wide trending keywords across live and recent sessions.",
      "parameters": {
        "type": "object",
        "required": []
        "properties": {
          "institutionDid": {
            "type": "string",
            "format": "did",
            "description": "DID of the institution to scope trending keywords."
          },
          "withinHours": {
            "type": "integer",
            "default": 24,
            "description": "Look back window in hours."
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "description": "Maximum number of trending keywords to return."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["keywords", "computedAt"],
          "properties": {
            "keywords": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#trendingKeyword"
              }
            },
            "computedAt": {
              "type": "string",
              "format": "datetime",
              "description": "Timestamp when this trending data was computed."
            }
          }
        }
      }
    },
    "trendingKeyword": {
      "type": "object",
      "required": ["text", "count", "sessionUri", "courseUri"],
      "properties": {
        "text": {
          "type": "string",
          "description": "The keyword text."
        },
        "count": {
          "type": "integer",
          "description": "Number of submissions for this keyword."
        },
        "sessionUri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT URI of the session where this keyword is trending."
        },
        "courseUri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT URI of the course this keyword belongs to."
        }
      }
    }
  }
}
