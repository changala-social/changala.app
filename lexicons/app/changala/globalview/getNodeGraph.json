{
  "lexicon": 1,
  "id": "app.changala.globalview.getNodeGraph",
  "description": "Get the local graph around a brain node.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the local graph around a brain node.",
      "parameters": {
        "type": "object",
        "required": ["nodeUri"],
        "properties": {
          "nodeUri": {
            "type": "string",
            "format": "at-uri",
            "description": "AT URI of the brain node to center the graph on."
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 2,
            "description": "How many hops to traverse from the center node."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#graphNode"
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#graphEdge"
              }
            }
          }
        }
      }
    },
    "graphNode": {
      "type": "object",
      "required": ["uri", "title", "authorDid", "tags"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT URI of the brain node."
        },
        "title": {
          "type": "string",
          "description": "Title of the brain node."
        },
        "authorDid": {
          "type": "string",
          "format": "did",
          "description": "DID of the node author."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags on this node."
        },
        "summary": {
          "type": "string",
          "description": "Optional short summary for graph tooltips."
        }
      }
    },
    "graphEdge": {
      "type": "object",
      "required": ["fromUri", "toUri"],
      "properties": {
        "fromUri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT URI of the source node."
        },
        "toUri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT URI of the target node."
        },
        "label": {
          "type": "string",
          "description": "Optional edge label (e.g. see also, contradicts, expands)."
        }
      }
    }
  }
}
