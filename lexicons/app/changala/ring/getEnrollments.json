{
  "lexicon": 1,
  "id": "app.changala.ring.getEnrollments",
  "description": "Get the list of enrolled students for a course.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Retrieve all enrolled DIDs for a given course.",
      "parameters": {
        "type": "params",
        "required": ["courseUri"],
        "properties": {
          "courseUri": {
            "type": "string",
            "format": "at-uri",
            "description": "AT URI of the course."
          },
          "cursor": {
            "type": "string",
            "description": "Pagination cursor."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100,
            "description": "Maximum number of results to return."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["courseUri", "dids", "total"],
          "properties": {
            "courseUri": {
              "type": "string",
              "format": "at-uri"
            },
            "dids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "did"
              },
              "description": "List of enrolled student DIDs."
            },
            "total": {
              "type": "integer",
              "description": "Total number of enrolled students."
            },
            "cursor": {
              "type": "string",
              "description": "Pagination cursor for next page."
            }
          }
        }
      }
    }
  }
}
