{
  "lexicon": 1,
  "id": "app.changala.ring.rescheduleSession",
  "description": "Reschedule a session to a new time.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Reschedule a session. Triggers high-priority notification. Requires class rep or admin role.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["sessionUri", "rescheduledTo"],
          "properties": {
            "sessionUri": {
              "type": "string",
              "format": "at-uri",
              "description": "AT URI of the session to reschedule."
            },
            "rescheduledTo": {
              "type": "string",
              "format": "datetime",
              "description": "New scheduled time for the session."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "courseUri", "scheduledAt", "durationMins", "status", "createdBy", "keywordWindowOpen", "createdAt"],
          "properties": {
            "uri": {
              "type": "string",
              "format": "at-uri"
            },
            "courseUri": {
              "type": "string",
              "format": "at-uri"
            },
            "scheduledAt": {
              "type": "string",
              "format": "datetime"
            },
            "durationMins": {
              "type": "integer"
            },
            "status": {
              "type": "string"
            },
            "createdBy": {
              "type": "string",
              "format": "did"
            },
            "topic": {
              "type": "string"
            },
            "openedAt": {
              "type": "string",
              "format": "datetime"
            },
            "closedAt": {
              "type": "string",
              "format": "datetime"
            },
            "keywordWindowExpiresAt": {
              "type": "string",
              "format": "datetime"
            },
            "keywordWindowOpen": {
              "type": "boolean"
            },
            "rescheduledTo": {
              "type": "string",
              "format": "datetime"
            },
            "createdAt": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      }
    }
  }
}
