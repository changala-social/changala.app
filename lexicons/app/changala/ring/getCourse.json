{
  "lexicon": 1,
  "id": "app.changala.ring.getCourse",
  "description": "Get details of a specific course.",
  "defs": {
    "main": {
      "type": "query",
      "description": "Retrieve a course by its AT URI.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "at-uri",
            "description": "AT URI of the course record."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "title", "code", "department", "semester", "visibility", "createdBy", "createdAt", "enrolledCount"],
          "properties": {
            "uri": {
              "type": "string",
              "format": "at-uri"
            },
            "title": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "department": {
              "type": "string"
            },
            "semester": {
              "type": "string"
            },
            "visibility": {
              "type": "string"
            },
            "createdBy": {
              "type": "string",
              "format": "did"
            },
            "classRepDid": {
              "type": "string",
              "format": "did"
            },
            "description": {
              "type": "string"
            },
            "createdAt": {
              "type": "string",
              "format": "datetime"
            },
            "enrolledCount": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
