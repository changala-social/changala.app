{
  "lexicon": 1,
  "id": "app.changala.ring.loadCalendar",
  "description": "Load academic calendar (phases and holidays) for a semester.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Admin only. Loads instructional phases, exam periods, festivals, and holidays into the Ring for session provisioning.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["semester", "phases", "holidays"],
          "properties": {
            "semester": {
              "type": "string",
              "description": "Semester identifier (e.g. '2025-winter')."
            },
            "phases": {
              "type": "array",
              "description": "Calendar phases (instructional, exam, festival, administrative).",
              "items": {
                "type": "object",
                "required": ["name", "label", "type", "start", "end"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Phase identifier."
                  },
                  "label": {
                    "type": "string",
                    "description": "Human-readable label."
                  },
                  "type": {
                    "type": "string",
                    "description": "Phase type: 'instructional', 'exam', 'festival', 'administrative'."
                  },
                  "start": {
                    "type": "string",
                    "description": "Start date (YYYY-MM-DD)."
                  },
                  "end": {
                    "type": "string",
                    "description": "End date (YYYY-MM-DD)."
                  }
                }
              }
            },
            "holidays": {
              "type": "array",
              "description": "Holidays within the semester.",
              "items": {
                "type": "object",
                "required": ["date", "name"],
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "Holiday date (YYYY-MM-DD)."
                  },
                  "name": {
                    "type": "string",
                    "description": "Holiday name."
                  }
                }
              }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["semester", "phasesLoaded", "holidaysLoaded"],
          "properties": {
            "semester": {
              "type": "string"
            },
            "phasesLoaded": {
              "type": "integer"
            },
            "holidaysLoaded": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
