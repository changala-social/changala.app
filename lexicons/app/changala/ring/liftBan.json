{
  "lexicon": 1,
  "id": "app.changala.ring.liftBan",
  "description": "Lift an existing ban on a DID.",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Remove a ban from a user. Requires admin role.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["targetDid"],
          "properties": {
            "targetDid": {
              "type": "string",
              "format": "did",
              "description": "DID of the user to unban."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["targetDid", "liftedAt"],
          "properties": {
            "targetDid": {
              "type": "string",
              "format": "did"
            },
            "liftedAt": {
              "type": "string",
              "format": "datetime",
              "description": "When the ban was lifted."
            }
          }
        }
      }
    }
  }
}
