#!/usr/bin/env bash
# .githooks/pre-commit — auto-format before every commit

set -euo pipefail

git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.rs$' || exit 0

cargo fmt

CHANGED=$(git diff --name-only | grep -E '\.rs$' || true)
if [ -n "$CHANGED" ]; then
  echo "$CHANGED" | xargs git add
fi
